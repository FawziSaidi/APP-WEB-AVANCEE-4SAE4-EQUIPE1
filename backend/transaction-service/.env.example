# Transaction Service Environment Variables
DATABASE_URL=sqlite+aiosqlite:///./data/transactions.db

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ISSUER_URL=http://localhost:8180
KEYCLOAK_REALM=ProlanceRealm
KEYCLOAK_CLIENT_ID=api-gateway

# User Service
USER_SERVICE_URL=http://localhost:8081

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=app.events
RABBITMQ_TRANSACTION_QUEUE=transaction.completed

# App
APP_HOST=0.0.0.0
APP_PORT=8086
CORS_ORIGINS=http://localhost:4200
