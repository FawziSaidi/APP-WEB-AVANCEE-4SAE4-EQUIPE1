# Transaction Service Environment Variables
DATABASE_URL=sqlite+aiosqlite:///./data/transactions.db

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=esprit-realm
KEYCLOAK_CLIENT_ID=transaction-service

# User Service
USER_SERVICE_URL=http://localhost:8082

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=app.events
RABBITMQ_TRANSACTION_QUEUE=transaction.completed

# App
APP_HOST=0.0.0.0
APP_PORT=8084
CORS_ORIGINS=http://localhost:4200
